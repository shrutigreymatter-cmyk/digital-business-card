<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#20d8b7">
  <title>Rahul Vijayvargiya | Digital Business Card</title>
  <style>
    :root {
      --teal: #20d8b7;
      --deep-teal: #079f83;
      --ink: #24212b;
      --muted: #666674;
      --icon-bg: #ddf4ef;
      --card: #ffffff;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 24px 14px;
      background: #f4f7f6;
      color: var(--ink);
      font-family: Arial, Helvetica, sans-serif;
    }
    .page {
      width: 100%;
      max-width: 620px;
      margin: 0 auto;
      padding: 28px 18px 22px;
      background: var(--teal);
      border-radius: 18px;
    }
    .profile {
      text-align: center;
      padding: 0 8px 22px;
    }
    .avatar {
      width: 138px;
      height: 138px;
      margin: 0 auto 24px;
      border-radius: 50%;
      border: 7px solid rgba(0, 159, 131, .30);
      background: #e7f8f4;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--deep-teal);
      font-size: 42px;
      font-weight: 700;
      letter-spacing: 1px;
    }
    .intro {
      background: var(--card);
      border-radius: 10px;
      padding: 28px 18px 24px;
      box-shadow: 0 2px 5px rgba(0,0,0,.08);
      margin-bottom: 14px;
    }
    .designation {
      margin: 0 0 12px;
      color: var(--muted);
      font-size: clamp(14px, 3.4vw, 19px);
      font-weight: 700;
      line-height: 1.45;
      text-transform: uppercase;
    }
    h1 {
      margin: 0 0 24px;
      font-size: clamp(25px, 5.4vw, 34px);
      line-height: 1.2;
      color: #111111;
    }
    .add-contact {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      min-height: 52px;
      padding: 0 32px;
      border-radius: 999px;
      background: var(--deep-teal);
      color: #fff;
      font-weight: 700;
      font-size: 17px;
      text-decoration: none;
      border: 0;
      cursor: pointer;
    }
    .quick-links {
      display: flex;
      justify-content: center;
      gap: 34px;
      margin-top: 22px;
    }
    .quick-links a {
      color: var(--deep-teal);
      text-decoration: none;
      display: inline-flex;
      padding: 4px;
    }
    .quick-links svg { width: 30px; height: 30px; }
    .detail {
      display: flex;
      align-items: center;
      gap: 18px;
      padding: 18px;
      margin: 14px 0;
      background: var(--card);
      border-radius: 10px;
      box-shadow: 0 2px 5px rgba(0,0,0,.08);
      min-height: 94px;
    }
    .detail-icon {
      width: 64px;
      height: 64px;
      flex: 0 0 64px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 9px;
      background: var(--icon-bg);
      color: var(--deep-teal);
    }
    .detail-icon svg { width: 30px; height: 30px; }
    .detail-text { min-width: 0; }
    .detail-label {
      color: var(--muted);
      font-size: 17px;
      font-weight: 700;
      margin-bottom: 7px;
    }
    .detail-value {
      color: var(--ink);
      font-size: clamp(15px, 3.8vw, 19px);
      line-height: 1.45;
      overflow-wrap: anywhere;
      text-decoration: none;
    }
    .company-name { font-weight: 700; }
    .former { display: block; font-size: 14px; color: var(--muted); margin-top: 5px; line-height: 1.45; }
    .address { line-height: 1.55; }
    .footer {
      text-align: center;
      padding: 16px 4px 2px;
      color: #086e60;
      font-size: 12px;
    }
    @media (max-width: 420px) {
      body { padding: 0; background: var(--teal); }
      .page { border-radius: 0; padding: 22px 14px 18px; }
      .detail { gap: 13px; padding: 14px; }
      .detail-icon { width: 54px; height: 54px; flex-basis: 54px; }
      .detail-label { font-size: 15px; }
      .detail-value { font-size: 15px; }
    }
  </style>
</head>
<body>
  <main class="page">
    <section class="profile" aria-label="Digital business card">
      <div class="avatar" aria-label="Rahul Vijayvargiya initials">RV</div>
      <div class="intro">
        <p class="designation">Chief Human Resources Officer</p>
        <h1>Rahul Vijayvargiya</h1>
        <a class="add-contact" id="saveContact" href="#">Add Contact</a>
        <div class="quick-links">
          <a href="tel:+919820236318" aria-label="Call Rahul Vijayvargiya" title="Call">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.62 2.62a2 2 0 0 1-.45 2.11L8 9.63a16 16 0 0 0 6 6l1.18-1.27a2 2 0 0 1 2.11-.45c.84.29 1.72.5 2.62.62A2 2 0 0 1 22 16.92z"/></svg>
          </a>
          <a href="mailto:rahul.vijayvargiya@evonilepharma.com" aria-label="Email Rahul Vijayvargiya" title="Email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg>
          </a>
        </div>
      </div>
    </section>

    <section class="detail">
      <div class="detail-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M9 5h6M9 18h6"/><path d="M11 20h2"/></svg>
      </div>
      <div class="detail-text">
        <div class="detail-label">Mobile</div>
        <a class="detail-value" href="tel:+919820236318">+91 98202 36318</a>
      </div>
    </section>

    <section class="detail">
      <div class="detail-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg>
      </div>
      <div class="detail-text">
        <div class="detail-label">Email</div>
        <a class="detail-value" href="mailto:rahul.vijayvargiya@evonilepharma.com">rahul.vijayvargiya@evonilepharma.com</a>
      </div>
    </section>

    <section class="detail">
      <div class="detail-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
      </div>
      <div class="detail-text">
        <div class="detail-label">Website</div>
        <a class="detail-value" href="https://www.evonilepharma.com/" target="_blank" rel="noopener">www.evonilepharma.com</a>
      </div>
    </section>

    <section class="detail">
      <div class="detail-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v3M3 12h18"/></svg>
      </div>
      <div class="detail-text">
        <div class="detail-label">Company</div>
        <div class="detail-value company-name">Evonle Pharma Limited</div>
        <span class="former">Formerly Known As Novartis India Limited</span>
      </div>
    </section>

    <section class="detail">
      <div class="detail-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-5.5 7-12a7 7 0 0 0-14 0c0 6.5 7 12 7 12z"/><circle cx="12" cy="9" r="2.3"/></svg>
      </div>
      <div class="detail-text">
        <div class="detail-label">Address</div>
        <div class="detail-value address">101, Supreme Business Park, A Wing,<br>1st Floor, Hiranandani Gardens,<br>Powai, Mumbai 400076</div>
      </div>
    </section>

    <div class="footer">Digital Business Card</div>
  </main>

  <script>
    const contact = [
      "BEGIN:VCARD",
      "VERSION:3.0",
      "N:Vijayvargiya;Rahul;;;",
      "FN:Rahul Vijayvargiya",
      "ORG:Evonle Pharma Limited",
      "TITLE:Chief Human Resources Officer",
      "TEL;TYPE=CELL,VOICE:+919820236318",
      "EMAIL;TYPE=INTERNET:rahul.vijayvargiya@evonilepharma.com",
      "URL:https://www.evonilepharma.com/",
      "ADR;TYPE=WORK:;;101, Supreme Business Park, A Wing, 1st Floor;Powai;Mumbai;;400076",
      "NOTE:Formerly Known As Novartis India Limited",
      "END:VCARD"
    ].join("\r\n");

    document.getElementById("saveContact").addEventListener("click", function (event) {
      event.preventDefault();
      const blob = new Blob([contact], { type: "text/vcard;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.download = "Rahul_Vijayvargiya.vcf";
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
    });
  </script>
</body>
</html>
